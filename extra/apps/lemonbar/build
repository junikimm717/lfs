#!/bin/sh
set -eu

DIR="$(realpath "$(dirname "$0" )" )"
NAME="$(basename "$DIR")"

# You MUST make sure that we are in a correct environment.
test -z "$INOSENV" && {
  echo "You cannot run this script while not in the mimuxenv!" && \
  exit 1;
}

# lemonbar (the drscream Xft fork): the actual status-bar renderer. It draws
# whatever the mimux-panel script feeds it on stdin. Xft support lets it use the
# shipped DejaVu TTF; alpha colors compose against picom for a translucent bar.
VERSION="2.0"
BASEURL="https://github.com/drscream/lemonbar-xft/archive/refs/tags"
SRCDIR="lemonbar-xft-$VERSION"
TARBALL="$SRCDIR.tar.gz"

# Out-of-tree: tarball cached in $TARBALLS, unpacked/built under $WORK.
WORK="${BUILDDIR:?set BUILDDIR -- re-activate the mimuxenv}/$NAME"

download() {
  echo "downloading lemonbar source..."
  mkdir -p "$TARBALLS"
  if test -f "$TARBALLS/$TARBALL"; then
    echo "$TARBALL exists, skipping..."
    return
  fi
  curl -Lfo "$TARBALLS/$TARBALL" --retry 5 --retry-delay 5 --retry-all-errors "$BASEURL/v$VERSION.tar.gz"
}

extract() {
  echo "extracting lemonbar source..."
  if ! test -f "$TARBALLS/$TARBALL"; then
    echo "No tarball to operate on!"
    exit 1
  fi

  rm -rf "$WORK"
  mkdir -p "$WORK"
  tar xf "$TARBALLS/$TARBALL" -C "$WORK"
}

makeinstall() {
  echo "building lemonbar..."
  if ! test -d "$WORK/$SRCDIR"; then
    echo "No source directory to operate on!"
    exit 1
  fi
  cd "$WORK/$SRCDIR"

  # The Makefile hardcodes -I/usr/include/freetype2 (the builder's, not the
  # sysroot's); feed it the real freetype2/xft include paths via pkg-config so
  # ft2build.h and Xft.h resolve against $ROOTFS.
  export CFLAGS="${CFLAGS:-} $(pkg-config --cflags freetype2 xft)"
  make CC="$CC"

  # `make install` also builds a man page via asciidoc (not shipped); install
  # just the binary ourselves.
  install -Dm755 lemonbar "$ROOTFS/usr/bin/lemonbar"
}

clear() {
  # Drop the out-of-tree build dir. The cached tarball in $TARBALLS is kept.
  rm -rf "$WORK"
}

case "$1" in
  download|d) download ;;
  extract|e) extract ;;
  makeinstall|mi) makeinstall ;;
  clear|clean|c) clear ;;
  all|a) download && extract && makeinstall ;;
  *)
    cat <<EOF
Build script for lemonbar (xft fork)

download|d -> download the tarball into \$TARBALLS
extract|e -> extract the tarball under \$BUILDDIR
makeinstall|mi -> make and install the binary
clear|clean|c -> remove the out-of-tree build dir
all|a -> download, extract, and makeinstall.
EOF
    exit 1
    ;;
esac
