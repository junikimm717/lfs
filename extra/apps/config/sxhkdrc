# mimux default keybindings (bspwm + sxhkd).
#
# The modifier is Alt (mod1), not Super: under a Wayland host (e.g. Hyprland)
# the compositor grabs Super globally, so it never reaches the guest. The layout
# below mirrors the user's Hyprland binds, with Super swapped for Alt.

# terminal (your Super+Shift+A; Return also works)
alt + shift + a
	st
alt + Return
	st

# application launcher (your Super+Space -> rofi; here dmenu)
alt + space
	dmenu_run
alt + p
	dmenu_run

# close focused window (your Super+Shift+Q)
alt + shift + q
	bspc node -c

# quit / restart bspwm (your Super+Shift+E exits)
alt + shift + e
	bspc quit
alt + shift + r
	bspc wm -r

# reload sxhkd configuration
alt + shift + c
	pkill -USR1 -x sxhkd

# toggle floating (your Super+V) / fullscreen
alt + v
	bspc node -t ~floating
alt + f
	bspc node -t ~fullscreen

# focus the node in the given direction (your Super+h/j/k/l)
alt + {h,j,k,l}
	bspc node -f {west,south,north,east}

# swap the focused node in the given direction (your Super+Shift+h/j/k/l)
alt + shift + {h,j,k,l}
	bspc node -s {west,south,north,east}

# focus the given desktop (your Super+1..0, 0 -> desktop 10)
alt + {1-9,0}
	bspc desktop -f '^{1-9,10}'

# send the focused node to the given desktop (your Super+Shift+1..0)
alt + shift + {1-9,0}
	bspc node -d '^{1-9,10}'
