# mimux default keybindings (bspwm + sxhkd).

# terminal emulator
super + Return
	st

# reload sxhkd configuration
super + Escape
	pkill -USR1 -x sxhkd

# quit / restart bspwm
super + alt + {q,r}
	bspc {quit,wm -r}

# close focused window
super + w
	bspc node -c

# toggle fullscreen / floating
super + {f,space}
	bspc node -t {fullscreen,floating}

# focus the node in the given direction
super + {h,j,k,l}
	bspc node -f {west,south,north,east}

# focus (or send the focused node to) the given desktop
super + {_,shift + }{1-5}
	bspc {desktop -f,node -d} '^{1-5}'
