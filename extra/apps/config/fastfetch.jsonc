{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // The logo is Mimi's face; $1-$4 don't follow the panel theme -- they depict
  // the actual cat (a chinchilla-silver Persian): silver fur, green eyes, a
  // pink nose, and the darker silver "tipping" on her ear tips.
  // See /usr/share/mimux/mimi.txt.
  "logo": {
    "type": "file",
    "source": "/usr/share/mimux/mimi.txt",
    "color": {
      "1": "38;2;214;216;220",
      "2": "38;2;132;176;104",
      "3": "38;2;226;148;152",
      "4": "38;2;150;150;156"
    },
    "padding": { "top": 2, "left": 2, "right": 4 }
  },

  "display": {
    "separator": "  ",
    "key": { "width": 8 },
    "color": {
      "keys": "38;2;166;179;133",
      "title": "38;2;208;169;106",
      "separator": "38;2;166;179;133"
    }
  },

  "modules": [
    "title",
    { "type": "separator", "string": "─" },
    { "type": "os",       "key": "mimux" },
    { "type": "kernel",   "key": "kernel" },
    { "type": "uptime",   "key": "uptime" },
    { "type": "shell",    "key": "shell" },
    { "type": "wm",       "key": "wm" },
    { "type": "terminal", "key": "term" },
    { "type": "cpu",      "key": "cpu" },
    { "type": "memory",   "key": "mem" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
