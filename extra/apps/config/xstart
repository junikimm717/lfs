#!/bin/sh
# Minimal X session launcher for mimux.
#
# Deliberately avoids startx/xauth (and their libXmu/libXt/libICE/libSM
# dependency chain): it just runs xinit with the system xinitrc, starting the
# server on display :0 / vt1. Run this from a tty after logging in as mimi.
exec xinit /etc/X11/xinit/xinitrc -- :0 vt1
