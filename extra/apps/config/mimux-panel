#!/bin/sh
# mimux-panel -- a Nord-themed lemonbar panel for bspwm.
#
# Merges three streams into one bar:
#   * bspwm desktop state  (bspc subscribe report)  -> left, clickable
#   * focused window title  (xtitle)                -> center
#   * cpu / mem / clock     (slstatus -s)           -> right
# The bar renders through picom, so the alpha in the background colour makes it
# translucent. Launched from bspwmrc.

FIFO="/tmp/mimux-panel.fifo"
FONT="DejaVu Sans Mono:size=11"
HEIGHT=24

# --- Mimicoco palette (matched to the wallpaper) ---
BG="#cc262320"   # warm charcoal, ~80% opaque (composited by picom)
FG="#ebe3d5"     # cream (tiles / silver fur)
ACC="#a6b385"    # sage plant  (focused desktop background)
ACC_FG="#262320" # dark text on the accent
OCC="#ebe3d5"    # bright cream (occupied desktop)
IDLE="#8b8378"   # warm grey    (empty desktop)
URG="#c17a54"    # terracotta   (urgent)
TITLE_FG="#d0a96a" # amber (warm wood light)

# Clean up any previous instance, then make a fresh fifo.
pkill -x lemonbar  >/dev/null 2>&1
pkill -x xtitle    >/dev/null 2>&1
pkill -x slstatus  >/dev/null 2>&1
[ -e "$FIFO" ] && rm -f "$FIFO"
mkfifo "$FIFO"

# Feed the three sources into the fifo, each tagged by its first character.
bspc subscribe report                                     > "$FIFO" &
xtitle -sf 'T%s' -t 120                                    > "$FIFO" &
slstatus -s | while IFS= read -r s; do printf 'S%s\n' "$s"; done > "$FIFO" &

# Parse the tagged stream and emit a formatted lemonbar line.
parse() {
  wm=""
  title=""
  stat=""
  while IFS= read -r line; do
    case "$line" in
      W*)   # desktop report, colon-separated items; first char is the type
        wm=""
        rest="${line#W}"
        oldifs="$IFS"; IFS=":"
        for item in $rest; do
          typ="${item%"${item#?}"}"   # first character
          name="${item#?}"            # the rest (desktop name / monitor / flag)
          case "$typ" in
            O|F) wm="$wm%{B$ACC}%{F$ACC_FG} $name %{F-}%{B-}" ;;                       # focused
            o)   wm="$wm%{A:bspc desktop -f $name:}%{F$OCC} $name %{F-}%{A}" ;;         # occupied
            f)   wm="$wm%{A:bspc desktop -f $name:}%{F$IDLE} $name %{F-}%{A}" ;;        # empty
            U|u) wm="$wm%{A:bspc desktop -f $name:}%{F$URG} $name %{F-}%{A}" ;;         # urgent
          esac
        done
        IFS="$oldifs" ;;
      T*)   title="${line#T}" ;;
      S*)   stat="${line#S}" ;;
    esac
    printf '%%{l} %s%%{c}%%{F%s}%s%%{F-}%%{r}%s \n' "$wm" "$TITLE_FG" "$title" "$stat"
  done
}

parse < "$FIFO" \
  | lemonbar -p -n mimuxbar -f "$FONT" -g "x$HEIGHT" -B "$BG" -F "$FG" -a 32 \
  | sh &

wait
