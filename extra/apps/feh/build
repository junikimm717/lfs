#!/bin/sh
set -eu

DIR="$(realpath "$(dirname "$0" )" )"
NAME="$(basename "$DIR")"

# You MUST make sure that we are in a correct environment.
test -z "$INOSENV" && {
  echo "You cannot run this script while not in the mimuxenv!" && \
  exit 1;
}

# feh: the lightweight image viewer used purely as the wallpaper setter here
# (feh --bg-fill). It renders via Imlib2 and links X11 + Xinerama. Network
# fetching (libcurl) is disabled so the base image needs no HTTP stack.
#
# mimicoco.jpg lives in this package directory as a build input and is installed
# to /usr/share/mimux/ for bspwmrc to set as the desktop background.
VERSION="3.10.3"
BASEURL="https://feh.finalrewind.org"
SRCDIR="feh-$VERSION"
TARBALL="$SRCDIR.tar.bz2"
WALLPAPER="mimicoco.jpg"

# Out-of-tree: tarball cached in $TARBALLS, unpacked/built under $WORK.
WORK="${BUILDDIR:?set BUILDDIR -- re-activate the mimuxenv}/$NAME"

download() {
  echo "downloading feh source..."
  mkdir -p "$TARBALLS"
  if test -f "$TARBALLS/$TARBALL"; then
    echo "$TARBALL exists, skipping..."
    return
  fi
  curl -Lfo "$TARBALLS/$TARBALL" --retry 5 --retry-delay 5 --retry-all-errors "$BASEURL/$TARBALL"
}

extract() {
  echo "extracting feh source..."
  if ! test -f "$TARBALLS/$TARBALL"; then
    echo "No tarball to operate on!"
    exit 1
  fi

  rm -rf "$WORK"
  mkdir -p "$WORK"
  tar xf "$TARBALLS/$TARBALL" -C "$WORK"
  cd "$WORK/$SRCDIR"

  # feh pulls in <X11/Intrinsic.h> (libXt) purely as an umbrella header for
  # Xlib/Xutil/Xresource -- it uses no Toolkit Intrinsics itself (only Window,
  # Atom and the XValue geometry macros). Point it at the concrete libX11
  # headers so we don't have to build the libXt/libICE/libSM stack.
  sed -i \
    's|#include <X11/Intrinsic.h>.*|#include <X11/Xlib.h>\n#include <X11/Xutil.h>\n#include <X11/Xresource.h>|' \
    src/wallpaper.h
}

makeinstall() {
  echo "building feh..."
  if ! test -d "$WORK/$SRCDIR"; then
    echo "No source directory to operate on!"
    exit 1
  fi
  if ! test -f "$DIR/$WALLPAPER"; then
    echo "Missing build input $WALLPAPER!"
    exit 1
  fi
  cd "$WORK/$SRCDIR"

  # feh has no ./configure; features are toggled via make variables. Disable
  # libcurl (curl=0); keep Xinerama (shipped in the graphical stack). X11 and
  # Imlib2 flags are resolved through pkg-config against the sysroot.
  make -j"${JOBS:-8}" \
    CC="$CC" \
    PREFIX=/usr \
    PKG_CONFIG=pkg-config \
    curl=0

  make PREFIX=/usr DESTDIR="$ROOTFS" curl=0 install

  # Ship the default wallpaper.
  install -Dm644 "$DIR/$WALLPAPER" "$ROOTFS/usr/share/mimux/$WALLPAPER"
}

clear() {
  rm -rf "$WORK"
}

case "$1" in
  download|d)
    download
    ;;
  extract|e)
    extract
    ;;
  makeinstall|mi)
    makeinstall
    ;;
  clear|clean|c)
    clear
    ;;
  all|a)
    download && extract && makeinstall
    ;;
  *)
    cat <<EOF
Build script for feh

download|d -> download the tarball
extract|e -> extract and patch the tarball
makeinstall|mi -> make and install the build artifacts
clear|clean|c -> clean all artifacts
all|a -> clean, and then go through everything.
EOF
    exit 1
    ;;
esac
