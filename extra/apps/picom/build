#!/bin/sh
set -eu

DIR="$(realpath "$(dirname "$0" )" )"
cd "$DIR"

# You MUST make sure that we are in a correct environment.
test -z "$INOSENV" && {
  echo "You cannot run this script while not in the mimuxenv!" && \
  exit 1;
}

# picom: the standalone X11 compositor that gives us transparency (it composites
# st's 32-bit ARGB visual from the alpha patch). Built with the xrender backend
# only -- the opengl backend, D-Bus control, and PCRE regex rules are all
# disabled so we drag in no mesa/libepoxy, dbus, or pcre2.
VERSION="12.5"
BASEURL="https://github.com/yshui/picom/archive/refs/tags"
SRCDIR="picom-$VERSION"
TARBALL="$SRCDIR.tar.gz"

download() {
  cd "$DIR"
  echo "downloading picom source..."
  if test -f "$TARBALL"; then
    echo "$TARBALL exists, skipping..."
    return
  fi
  curl -Lfo "$TARBALL" --retry 5 --retry-delay 5 --retry-all-errors "$BASEURL/v$VERSION.tar.gz"
}

extract() {
  cd "$DIR"
  echo "extracting picom source..."
  if ! test -f "$TARBALL"; then
    echo "No tarball to operate on!"
    exit 1
  fi

  tar xf "$TARBALL"
  cd "$SRCDIR"
  # Native meson build (build arch == target arch), same as the xorg meson
  # packages: the cross $CC and sysroot paths in $CFLAGS/$LDFLAGS drive it, no
  # cross file needed. libev is picked up via cc.find_library('ev') (its schmorp
  # tarball ships no pkg-config file), libconfig/xcb-image/xcb-renderutil via
  # pkg-config, and uthash as a header check -- all installed before us.
  meson setup _build \
    --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var \
    --buildtype=release \
    -Dregex=false -Dopengl=false -Ddbus=false -Dwith_docs=false
}

makeinstall() {
  echo "building picom..."
  if ! test -d "$DIR/$SRCDIR/_build"; then
    echo "No build directory to operate on!"
    exit 1
  fi
  cd "$DIR/$SRCDIR"

  ninja -C _build -j"${JOBS:-8}"
  DESTDIR="$ROOTFS" ninja -C _build install
}

clear() {
  cd "$DIR"
  rm -rf ./*.tgz ./*.tar.xz ./*.tar.bz2 ./*.tar.gz "$SRCDIR" "$TARBALL"
}

cd "$DIR"
case "$1" in
  download|d) download ;;
  extract|e) extract ;;
  makeinstall|mi) makeinstall ;;
  clear|clean|c) clear ;;
  all|a) download && extract && makeinstall ;;
  *)
    cat <<EOF
Build script for picom

download|d -> download the tarball
extract|e -> extract and configure with meson
makeinstall|mi -> build and install the build artifacts
clear|clean|c -> clean all artifacts
all|a -> clean, and then go through everything.
EOF
    exit 1
    ;;
esac
