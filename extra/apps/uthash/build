#!/bin/sh
set -eu

DIR="$(realpath "$(dirname "$0" )" )"
NAME="$(basename "$DIR")"

# You MUST make sure that we are in a correct environment.
test -z "$INOSENV" && {
  echo "You cannot run this script while not in the mimuxenv!" && \
  exit 1;
}

# uthash: header-only hash/list macros. picom uses it at build time. There is
# nothing to compile -- we just install the headers into the sysroot.
VERSION="2.3.0"
BASEURL="https://github.com/troydhanson/uthash/archive/refs/tags"
SRCDIR="uthash-$VERSION"
TARBALL="$SRCDIR.tar.gz"

# Out-of-tree: tarball cached in $TARBALLS, unpacked/built under $WORK.
WORK="$BUILDDIR/$NAME"

download() {
  echo "downloading uthash source..."
  mkdir -p "$TARBALLS"
  if test -f "$TARBALLS/$TARBALL"; then
    echo "$TARBALL exists, skipping..."
    return
  fi
  curl -Lfo "$TARBALLS/$TARBALL" --retry 5 --retry-delay 5 --retry-all-errors "$BASEURL/v$VERSION.tar.gz"
}

extract() {
  echo "extracting uthash source..."
  if ! test -f "$TARBALLS/$TARBALL"; then
    echo "No tarball to operate on!"
    exit 1
  fi

  rm -rf "$WORK"
  mkdir -p "$WORK"
  tar xf "$TARBALLS/$TARBALL" -C "$WORK"
}

makeinstall() {
  echo "installing uthash headers..."
  if ! test -d "$WORK/$SRCDIR"; then
    echo "No source directory to operate on!"
    exit 1
  fi
  cd "$WORK/$SRCDIR"

  # Header-only: install the public headers into the sysroot include dir.
  for h in src/*.h; do
    install -Dm644 "$h" "$ROOTFS/usr/include/$(basename "$h")"
  done
}

clear() {
  rm -rf "$WORK"
}

case "$1" in
  download|d) download ;;
  extract|e) extract ;;
  makeinstall|mi) makeinstall ;;
  clear|clean|c) clear ;;
  all|a) download && extract && makeinstall ;;
  *)
    cat <<EOF
Build script for uthash (header-only)

download|d -> download the tarball
extract|e -> extract the tarball
makeinstall|mi -> install the headers into the sysroot
clear|clean|c -> clean all artifacts
all|a -> clean, and then go through everything.
EOF
    exit 1
    ;;
esac
