#!/bin/sh
set -eu

DIR="$(realpath "$(dirname "$0" )" )"
NAME="$(basename "$DIR")"

# You MUST make sure that we are in a correct environment.
test -z "$INOSENV" && {
  echo "You cannot run this script while not in the mimuxenv!" && \
  exit 1;
}

# slstatus: the suckless status monitor. It generates the right-hand side of the
# lemonbar panel (cpu / mem / clock). Configured via config.h (vendored here), so
# it is version-pinned and intentionally has no `version` script.
VERSION="1.1"
BASEURL="https://dl.suckless.org/tools"
SRCDIR="slstatus-$VERSION"
TARBALL="$SRCDIR.tar.gz"

# Out-of-tree: tarball cached in $TARBALLS, unpacked/built under $WORK.
WORK="${BUILDDIR:?set BUILDDIR -- re-activate the mimuxenv}/$NAME"

download() {
  echo "downloading slstatus source..."
  mkdir -p "$TARBALLS"
  if test -f "$TARBALLS/$TARBALL"; then
    echo "$TARBALL exists, skipping..."
    return
  fi
  curl -Lfo "$TARBALLS/$TARBALL" --retry 5 --retry-delay 5 --retry-all-errors "$BASEURL/$TARBALL"
}

extract() {
  echo "extracting slstatus source..."
  if ! test -f "$TARBALLS/$TARBALL"; then
    echo "No tarball to operate on!"
    exit 1
  fi

  rm -rf "$WORK"
  mkdir -p "$WORK"
  tar xf "$TARBALLS/$TARBALL" -C "$WORK"
  # Drop in the mimux config (cpu/mem/clock).
  cp "$DIR/config.h" "$WORK/$SRCDIR/config.h"
}

makeinstall() {
  echo "building slstatus..."
  if ! test -d "$WORK/$SRCDIR"; then
    echo "No source directory to operate on!"
    exit 1
  fi
  cd "$WORK/$SRCDIR"

  # config.mk hard-assigns X11INC/X11LIB (/usr/X11R6) and LDFLAGS, ignoring the
  # env. Point them at the sysroot and re-add -rpath-link so libX11's indirect
  # libxcb dependency resolves at link time.
  X11FLAGS="X11INC=$ROOTFS/usr/include X11LIB=$ROOTFS/usr/lib"
  LDF="-L$ROOTFS/usr/lib -L$ROOTFS/lib -s -Wl,-rpath-link,$ROOTFS/usr/lib -Wl,-rpath-link,$ROOTFS/lib"

  # shellcheck disable=SC2086
  make -j"${JOBS:-8}" CC="$CC" $X11FLAGS LDFLAGS="$LDF"
  # shellcheck disable=SC2086
  make PREFIX=/usr DESTDIR="$ROOTFS" $X11FLAGS LDFLAGS="$LDF" install
}

clear() {
  rm -rf "$WORK"
}

case "$1" in
  download|d) download ;;
  extract|e) extract ;;
  makeinstall|mi) makeinstall ;;
  clear|clean|c) clear ;;
  all|a) download && extract && makeinstall ;;
  *)
    cat <<EOF
Build script for slstatus

download|d -> download the tarball
extract|e -> extract and install the mimux config.h
makeinstall|mi -> make and install the build artifacts
clear|clean|c -> clean all artifacts
all|a -> clean, and then go through everything.
EOF
    exit 1
    ;;
esac
