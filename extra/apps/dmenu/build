#!/bin/sh
set -eu

DIR="$(realpath "$(dirname "$0" )" )"
NAME="$(basename "$DIR")"

# You MUST make sure that we are in a correct environment.
test -z "$INOSENV" && {
  echo "You cannot run this script while not in the mimuxenv!" && \
  exit 1;
}

# dmenu: the suckless launcher/menu (Alt+Space -> dmenu_run). Like st it has no
# ./configure and is configured through config.h, so this build is pinned to a
# specific version -- there is intentionally no `version` script (a blind bump
# would fight our config edits).
VERSION="5.4"
BASEURL="https://dl.suckless.org/tools"
SRCDIR="dmenu-$VERSION"
TARBALL="$SRCDIR.tar.gz"

# Out-of-tree: tarball cached in $TARBALLS, unpacked/built under $WORK.
WORK="$BUILDDIR/$NAME"

download() {
  echo "downloading dmenu source..."
  mkdir -p "$TARBALLS"
  if test -f "$TARBALLS/$TARBALL"; then
    echo "$TARBALL exists, skipping..."
    return
  fi
  curl -Lfo "$TARBALLS/$TARBALL" --retry 5 --retry-delay 5 --retry-all-errors "$BASEURL/$TARBALL"
}

extract() {
  echo "extracting dmenu source..."
  if ! test -f "$TARBALLS/$TARBALL"; then
    echo "No tarball to operate on!"
    exit 1
  fi

  rm -rf "$WORK"
  mkdir -p "$WORK"
  tar xf "$TARBALLS/$TARBALL" -C "$WORK"
  cd "$WORK/$SRCDIR"

  # Generate config.h up front and theme it (Nord palette, DejaVu font) to
  # match the rest of the mimux session. Doing it in extract keeps it reproducible.
  cp config.def.h config.h
  sed -i \
    -e 's|"monospace:size=10"|"DejaVu Sans Mono:size=11"|' \
    -e 's|\[SchemeNorm\] = { "#bbbbbb", "#222222" }|[SchemeNorm] = { "#ebe3d5", "#262320" }|' \
    -e 's|\[SchemeSel\] = { "#eeeeee", "#005577" }|[SchemeSel] = { "#262320", "#a6b385" }|' \
    config.h
}

makeinstall() {
  echo "building dmenu..."
  if ! test -d "$WORK/$SRCDIR"; then
    echo "No source directory to operate on!"
    exit 1
  fi
  cd "$WORK/$SRCDIR"

  # dmenu's config.mk defaults to /usr/X11R6 and the builder's freetype2 dir;
  # point everything at the sysroot instead (same treatment as st). Its config.mk
  # also sets LDFLAGS = $(LIBS) without appending the env, so we pass the full
  # link line ourselves (direct libs + -rpath-link) to resolve libXft/libX11's
  # indirect freetype/xcb/expat/Xrender dependencies.
  X11FLAGS="X11INC=$ROOTFS/usr/include X11LIB=$ROOTFS/usr/lib FREETYPEINC=$ROOTFS/usr/include/freetype2"
  LDF="-L$ROOTFS/usr/lib -L$ROOTFS/lib -lfontconfig -lXft -lXinerama -lX11 -Wl,-rpath-link,$ROOTFS/usr/lib -Wl,-rpath-link,$ROOTFS/lib"

  # shellcheck disable=SC2086
  make -j"${JOBS:-8}" CC="$CC" $X11FLAGS LDFLAGS="$LDF"
  # shellcheck disable=SC2086
  make PREFIX=/usr DESTDIR="$ROOTFS" $X11FLAGS LDFLAGS="$LDF" install
}

clear() {
  rm -rf "$WORK"
}

case "$1" in
  download|d) download ;;
  extract|e) extract ;;
  makeinstall|mi) makeinstall ;;
  clear|clean|c) clear ;;
  all|a) download && extract && makeinstall ;;
  *)
    cat <<EOF
Build script for dmenu

download|d -> download the tarball
extract|e -> extract and theme config.h
makeinstall|mi -> make and install the build artifacts
clear|clean|c -> clean all artifacts
all|a -> clean, and then go through everything.
EOF
    exit 1
    ;;
esac
