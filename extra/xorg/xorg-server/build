#!/bin/sh
set -eu

DIR="$(realpath "$(dirname "$0" )" )"
NAME="$(basename "$DIR")"

# You MUST make sure that we are in a correct environment.
test -z "$INOSENV" && {
  echo "You cannot run this script while not in the mimuxenv!" && \
  exit 1;
}

VERSION="21.1.16"
BASEURL="https://www.x.org/releases/individual/xserver"
SRCDIR="xorg-server-$VERSION"
TARBALL="$SRCDIR.tar.xz"

# Out-of-tree: tarball cached in $TARBALLS, unpacked/built under $WORK.
WORK="${BUILDDIR:?set BUILDDIR -- re-activate the mimuxenv}/$NAME"

download() {
  echo "downloading xorg-server source..."
  mkdir -p "$TARBALLS"
  if test -f "$TARBALLS/$TARBALL"; then
    echo "$TARBALL exists, skipping..."
    return
  fi
  curl -Lf --retry 5 --retry-delay 5 --retry-all-errors -o "$TARBALLS/$TARBALL" "$BASEURL/$TARBALL"
}

extract() {
  echo "extracting xorg-server source..."
  if ! test -f "$TARBALLS/$TARBALL"; then
    echo "No tarball to operate on!"
    exit 1
  fi

  rm -rf "$WORK"
  mkdir -p "$WORK"
  tar xf "$TARBALLS/$TARBALL" -C "$WORK"
  cd "$WORK/$SRCDIR"
  # modesetting's driver.h does `#include <shadow.h>` meaning its own
  # miext/shadow/shadow.h -- but DIX_CFLAGS (configure-generated) puts
  # $ROOTFS/usr/include ahead of miext/shadow on the -I search path, so it
  # resolves to musl's password-shadow header instead and fails to compile.
  # Point the include at the real file explicitly.
  patch -p1 < "$DIR/modesetting-shadow-header.patch"
  # The in-tree `modesetting` DDX (hw/xfree86/drivers/modesetting) only needs
  # DRM=yes + DRI2=yes to build (configure.ac: XORG_DRIVER_MODESETTING=yes).
  # DRI2 here just means the server-side DRI2 protocol extension (dri2proto
  # headers, already provided by xorgproto) -- it does NOT pull in mesa/GL.
  # All of the driver's actual GBM/EGL-accelerated code paths are compiled out
  # behind #ifdef GLAMOR_HAS_GBM, so with --disable-glamor it falls back to its
  # dumb_bo.c dumb-buffer path unconditionally: plain KMS against virtio-gpu's
  # DRM node, no mesa/libgbm/LLVM required. udev handles input hotplug and lets
  # Xorg autodetect the DRM device with no xorg.conf.d entry needed.
  ./configure --prefix="/usr" --exec-prefix="/usr" \
    --with-sysroot="${ROOTFS:-/}" \
    --enable-xorg \
    --disable-xwayland --disable-xnest --disable-xvfb --disable-xephyr \
    --disable-dmx --disable-xwin \
    --disable-glamor --disable-glx \
    --disable-dri --enable-dri2 --disable-dri3 \
    --disable-libunwind --disable-dtrace --disable-secure-rpc \
    --disable-docs --disable-devel-docs --disable-selective-werror \
    --disable-systemd-logind \
    --enable-config-udev \
    --with-sha1=libcrypto \
    --with-xkb-path=/usr/share/X11/xkb \
    --with-xkb-output=/var/lib/xkb \
    --with-xkb-bin-directory=/usr/bin \
    --with-fontrootdir=/usr/share/fonts/X11
}

makeinstall() {
  echo "building xorg-server..."
  if ! test -d "$WORK/$SRCDIR"; then
    echo "No source directory to operate on!"
    exit 1
  fi
  cd "$WORK/$SRCDIR"

  make -j"${JOBS:-8}"
  make -j"${JOBS:-8}" DESTDIR="$ROOTFS" install
}

clear() {
  rm -rf "$WORK"
}

case "$1" in
  download|d)
    download
    ;;
  extract|e)
    extract
    ;;
  makeinstall|mi)
    makeinstall
    ;;
  clear|clean|c)
    clear
    ;;
  all|a)
    download && extract && makeinstall
    ;;
  *)
    cat <<EOF
Build script for xorg-server

download|d -> download the tarball
extract|e -> extract and patch the tarball
makeinstall|mi -> make and install the build artifacts
clear|clean|c -> clean all artifacts
all|a -> clean, and then go through everything.
EOF
    exit 1
    ;;
esac
