#!/bin/sh
set -eu

DIR="$(realpath "$(dirname "$0" )" )"
cd "$DIR"

# You MUST make sure that we are in a correct environment.
test -z "$INOSENV" && {
  echo "You cannot run this script while not in the mimuxenv!" && \
  exit 1;
}

VERSION="21.1.16"
BASEURL="https://www.x.org/releases/individual/xserver"
SRCDIR="xorg-server-$VERSION"
TARBALL="$SRCDIR.tar.xz"

download() {
  cd "$DIR"
  echo "downloading xorg-server source..."
  if test -f "$TARBALL"; then
    echo "$TARBALL exists, skipping..."
    return
  fi
  curl -LOf --retry 5 --retry-delay 5 --retry-all-errors "$BASEURL/$TARBALL"
}

extract() {
  cd "$DIR"
  echo "extracting xorg-server source..."
  if ! test -f "$TARBALL"; then
    echo "No tarball to operate on!"
    exit 1
  fi

  tar xf "$TARBALL"
  cd "$SRCDIR"
  # A minimal Xorg DDX: no GL/DRI/glamor (we drive /dev/fb0 via the fbdev
  # driver), so mesa/libdrm are not required. udev handles input hotplug.
  ./configure --prefix="/usr" --exec-prefix="/usr" \
    --with-sysroot="${ROOTFS:-/}" \
    --enable-xorg \
    --disable-xwayland --disable-xnest --disable-xvfb --disable-xephyr \
    --disable-dmx --disable-xwin \
    --disable-glamor --disable-glx \
    --disable-dri --disable-dri2 --disable-dri3 \
    --disable-libunwind --disable-dtrace --disable-secure-rpc \
    --disable-docs --disable-devel-docs --disable-selective-werror \
    --disable-systemd-logind \
    --enable-config-udev \
    --with-sha1=libcrypto \
    --with-xkb-path=/usr/share/X11/xkb \
    --with-xkb-output=/var/lib/xkb \
    --with-xkb-bin-directory=/usr/bin \
    --with-fontrootdir=/usr/share/fonts/X11
}

makeinstall() {
  echo "building xorg-server..."
  if ! test -d "$DIR/$SRCDIR"; then
    echo "No source directory to operate on!"
    exit 1
  fi
  cd "$DIR/$SRCDIR"

  make -j"${JOBS:-8}"
  make -j"${JOBS:-8}" DESTDIR="$ROOTFS" install
}

clear() {
  cd "$DIR"
  rm -rf ./*.tgz ./*.tar.xz ./*.tar.bz2 ./*.tar.gz "$SRCDIR" "$TARBALL"
}

cd "$DIR"
case "$1" in
  download|d)
    download
    ;;
  extract|e)
    extract
    ;;
  makeinstall|mi)
    makeinstall
    ;;
  clear|clean|c)
    clear
    ;;
  all|a)
    download && extract && makeinstall
    ;;
  *)
    cat <<EOF
Build script for xorg-server

download|d -> download the tarball
extract|e -> extract and patch the tarball
makeinstall|mi -> make and install the build artifacts
clear|clean|c -> clean all artifacts
all|a -> clean, and then go through everything.
EOF
    exit 1
    ;;
esac
