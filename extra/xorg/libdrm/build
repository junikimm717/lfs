#!/bin/sh
set -eu

DIR="$(realpath "$(dirname "$0" )" )"
cd "$DIR"

# You MUST make sure that we are in a correct environment.
test -z "$INOSENV" && {
  echo "You cannot run this script while not in the mimuxenv!" && \
  exit 1;
}

VERSION="2.4.124"
BASEURL="https://dri.freedesktop.org/libdrm"
SRCDIR="libdrm-$VERSION"
TARBALL="$SRCDIR.tar.xz"

download() {
  cd "$DIR"
  echo "downloading libdrm source..."
  if test -f "$TARBALL"; then
    echo "$TARBALL exists, skipping..."
    return
  fi
  curl -LOf --retry 5 --retry-delay 5 --retry-all-errors "$BASEURL/$TARBALL"
}

extract() {
  cd "$DIR"
  echo "extracting libdrm source..."
  if ! test -f "$TARBALL"; then
    echo "No tarball to operate on!"
    exit 1
  fi

  tar xf "$TARBALL"
  cd "$SRCDIR"
  # Native meson build: build arch == target arch, so the cross $CC/$CXX and
  # the sysroot include/lib paths in $CFLAGS/$LDFLAGS drive the compile. No
  # cross file is needed (same reason autotools cross-compiles work here).
  #
  # Only the core libdrm is needed (for the Xorg modesetting KMS driver against
  # virtio-gpu). All vendor-specific GPU helper libraries are disabled to keep
  # the footprint minimal -- none of them are used by our target.
  meson setup _build \
    --prefix=/usr --libdir=lib --sysconfdir=/etc --localstatedir=/var \
    --buildtype=release -Ddefault_library=shared \
    -Dintel=disabled -Dradeon=disabled -Damdgpu=disabled -Dnouveau=disabled \
    -Dvmwgfx=disabled -Dvc4=disabled -Dfreedreno=disabled -Detnaviv=disabled \
    -Dexynos=disabled -Domap=disabled -Dtegra=disabled \
    -Dman-pages=disabled -Dtests=false -Dcairo-tests=disabled
}

makeinstall() {
  echo "building libdrm..."
  if ! test -d "$DIR/$SRCDIR/_build"; then
    echo "No build directory to operate on!"
    exit 1
  fi
  cd "$DIR/$SRCDIR"

  ninja -C _build -j"${JOBS:-8}"
  DESTDIR="$ROOTFS" ninja -C _build install
}

clear() {
  cd "$DIR"
  rm -rf ./*.tgz ./*.tar.xz ./*.tar.bz2 ./*.tar.gz "$SRCDIR" "$TARBALL"
}

cd "$DIR"
case "$1" in
  download|d)
    download
    ;;
  extract|e)
    extract
    ;;
  makeinstall|mi)
    makeinstall
    ;;
  clear|clean|c)
    clear
    ;;
  all|a)
    download && extract && makeinstall
    ;;
  *)
    cat <<EOF
Build script for libdrm

download|d -> download the tarball
extract|e -> extract and patch the tarball
makeinstall|mi -> make and install the build artifacts
clear|clean|c -> clean all artifacts
all|a -> clean, and then go through everything.
EOF
    exit 1
    ;;
esac
