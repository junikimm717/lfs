#!/bin/sh

set -eu

DIR="$(realpath "$(dirname "$0" )" )"
cd "$DIR"

# You MUST make sure that we are in a correct environment.
test -z "$INOSENV" && \
  echo "You cannot run this script while not in the mimuxenv!" && \
  exit 1

SRCDIR="$TARGET-native"
TARBALL="$SRCDIR.tgz"

# NOTE: unlike package builds, the toolchain is NOT built out-of-tree -- it is
# extracted in place at cross/$TARGET-native because tools/env.sh and buildall.sh
# hardcode that path as the cross compiler. Only the download tarball moves to
# the shared $TARBALLS cache.
download() {
  echo "downloading toolchain..."
  mkdir -p "$TARBALLS"
  if test -f "$TARBALLS/$TARBALL"; then
    return
  fi
  curl -Lf --retry 5 --retry-delay 5 --retry-all-errors \
    -o "$TARBALLS/$TARBALL" "https://dev.mit.junic.kim/cross/$(uname -m)/$TARBALL"
}

extract() {
  if ! test -f "$TARBALLS/$TARBALL"; then
    echo "no archive found"
    exit 1
  fi
  echo "extracting pre-built musl toolchain into cross/"
  tar -xzf "$TARBALLS/$TARBALL" -C "$DIR"
}

# The toolchain ships bin/cc, bin/gcc, bin/ld, ... as symlinks onto their
# $TARGET-prefixed binaries, so there is nothing left to link up: this only
# checks that what we extracted actually has them. Every binary is static, so
# there is no wrapper and no .real/ shadow tree to keep in sync either.
makeinstall() {
  echo "checking cross toolchain..."
  if ! test -d "$DIR/$SRCDIR"; then
    echo "No source directory to operate on!"
    exit 1
  fi
  missing=""
  for tool in cc gcc g++ cpp ld ar as nm ranlib readelf strip make; do
    test -e "$DIR/$SRCDIR/bin/$tool" || missing="$missing $tool"
  done
  if test -n "$missing"; then
    echo "toolchain has no unprefixed$missing in bin/" >&2
    echo "that is an old musl-cross-make tarball; remove" >&2
    echo "$TARBALLS/$TARBALL and re-run to fetch the current one." >&2
    exit 1
  fi
  echo "toolchain provides the unprefixed tool names."
}

clear() {
  # Remove the extracted toolchain; the cached tarball in $TARBALLS is kept.
  rm -rf "${DIR:?}/$SRCDIR"
}

cd "$DIR"
case "$1" in
  download|d)
    download
    ;;
  extract|e)
    extract
    ;;
  makeinstall|mi)
    makeinstall
    ;;
  clear|clean|c)
    clear
    ;;
  all|a)
    download && extract && makeinstall
    ;;
  *)
    cat <<EOF
Build script for the prebuilt musl toolchain (built by gccfactory)

download|d -> download the tarball
extract|e -> extract the tarball into cross/
makeinstall|mi -> check the extracted toolchain is usable
clear|clean|c -> clean everything except the tarballs (prevent extra downloads)
all|a -> go through the entire build process.
EOF
    exit 1
    ;;
esac
