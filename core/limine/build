#!/bin/sh
set -eu

DIR="$(realpath "$(dirname "$0" )" )"
NAME="$(basename "$DIR")"

# You MUST make sure that we are in a correct environment.
test -z "$INOSENV" && {
  echo "You cannot run this script while not in the mimuxenv!" && \
  exit 1;
}

VERSION="11.2.1"
BASEURL="https://codeberg.org/Limine/Limine/releases/download/v$VERSION"
SRCDIR="limine-$VERSION"
TARBALL="$SRCDIR.tar.gz"

# Out-of-tree: tarball cached in $TARBALLS, unpacked/built under $WORK.
WORK="${BUILDDIR:?set BUILDDIR -- re-activate the mimuxenv}/$NAME"

# Unbelievable that 9.6.0 actually requires these???
# gcc, ld, and friends should all be pointing to the musl cross toolchain
# because of work done in /tools/env.sh tho
export CC_FOR_TARGET="gcc"
export LD_FOR_TARGET="ld"
export OBJCOPY_FOR_TARGET="objcopy"
export OBJDUMP_FOR_TARGET="objdump"
export READELF_FOR_TARGET="readelf"

download() {
  echo "downloading limine source..."
  mkdir -p "$TARBALLS"
  if test -f "$TARBALLS/$TARBALL"; then
    echo "$TARBALL exists, skipping..."
    return
  fi

  curl -Lf --retry 5 --retry-delay 5 --retry-all-errors \
    -o "$TARBALLS/$TARBALL" "$BASEURL/$TARBALL"
}

extract() {
  echo "extracting limine source..."
  if ! test -f "$TARBALLS/$TARBALL"; then
    echo "No tarball to operate on!"
    exit 1
  fi

  uefi_arch=aarch64
  if echo "$TARGET" | grep 'x86' > /dev/null 2>&1; then
    uefi_arch=x86-64
  fi

  rm -rf "$WORK"
  mkdir -p "$WORK"
  tar xzf "$TARBALLS/$TARBALL" -C "$WORK"
  cd "$WORK/$SRCDIR"
  ./configure --prefix="/usr" --exec-prefix="/usr" --target="$TARGET"\
    --enable-uefi-$uefi_arch --with-sysroot="${ROOTFS:-/}"
}

makeinstall() {
  echo "building limine..."
  if ! test -d "$WORK/$SRCDIR"; then
    echo "No source directory to operate on!"
    exit 1
  fi
  cd "$WORK/$SRCDIR"

  make -j"${JOBS:-8}"
  make -j"${JOBS:-8}" DESTDIR="$ROOTFS" install
}

clear() {
  rm -rf "$WORK"
}

case "$1" in
  download|d)
    download
    ;;
  extract|e)
    extract
    ;;
  makeinstall|mi)
    makeinstall
    ;;
  clear|clean|c)
    clear
    ;;
  all|a)
    download && extract && makeinstall
    ;;
  *)
    cat <<EOF
Build script for limine

download|d -> download the tarball
extract|e -> extract and patch the tarball
makeinstall|mi -> make and install the build artifacts
clear|clean|c -> clean all artifacts
all|a -> clean, and then go through everything.
EOF
    exit 1
    ;;
esac
