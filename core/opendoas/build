#!/bin/sh
set -eu

DIR="$(realpath "$(dirname "$0" )" )"
NAME="$(basename "$DIR")"

# You MUST make sure that we are in a correct environment.
test -z "$INOSENV" && {
  echo "You cannot run this script while not in the mimuxenv!" && \
  exit 1;
}

VERSION="6.8.2"
BASEURL="https://github.com/Duncaen/OpenDoas/releases/download/v$VERSION"
SRCDIR="opendoas-$VERSION"
TARBALL="$SRCDIR.tar.gz"

# Out-of-tree: tarball cached in $TARBALLS, unpacked/built under $WORK.
WORK="$BUILDDIR/$NAME"

download() {
  echo "downloading opendoas source..."
  mkdir -p "$TARBALLS"
  if test -f "$TARBALLS/$TARBALL"; then
    echo "$TARBALL exists, skipping..."
    return
  fi

  curl -Lf --retry 5 --retry-delay 5 --retry-all-errors \
    -o "$TARBALLS/$TARBALL" "$BASEURL/$TARBALL"
}

extract() {
  echo "extracting opendoas source..."
  if ! test -f "$TARBALLS/$TARBALL"; then
    echo "No tarball to operate on!"
    exit 1
  fi

  rm -rf "$WORK"
  mkdir -p "$WORK"
  tar xzf "$TARBALLS/$TARBALL" -C "$WORK"
  cd "$WORK/$SRCDIR"
  # opendoas's build script actually just sucks
  OS=linux WITHOUT_TIMESTAMP='' WITHOUT_SHADOW='' ./configure \
    --prefix="/usr" --exec-prefix="/usr" --with-timestamp --with-shadow
}

makeinstall() {
  echo "building opendoas..."
  if ! test -d "$WORK/$SRCDIR"; then
    echo "No source directory to operate on!"
    exit 1
  fi
  cd "$WORK/$SRCDIR"

  make -j"${JOBS:-8}"
  make -j"${JOBS:-8}" DESTDIR="$ROOTFS" install

}

clear() {
  rm -rf "$WORK"
}

case "$1" in
  download|d)
    download
    ;;
  extract|e)
    extract
    ;;
  makeinstall|mi)
    makeinstall
    ;;
  clear|clean|c)
    clear
    ;;
  all|a)
    download && extract && makeinstall
    ;;
  *)
    cat <<EOF
Build script for opendoas

download|d -> download the tarball into \$TARBALLS
extract|e -> extract the tarball under \$BUILDDIR
makeinstall|mi -> make and install the build artifacts
clear|clean|c -> remove the out-of-tree build dir
all|a -> download, extract, and makeinstall.
EOF
    exit 1
    ;;
esac
