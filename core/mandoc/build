#!/bin/sh

set -eu

DIR="$(realpath "$(dirname "$0" )" )"
NAME="$(basename "$DIR")"

# You MUST make sure that we are in a correct environment.
test -z "$INOSENV" && {
  echo "You cannot run this script while not in the mimuxenv!" && \
  exit 1;
}

VERSION="1.14.6"
BASEURL="https://mandoc.bsd.lv/snapshots"
SRCDIR="mandoc-$VERSION"
TARBALL="$SRCDIR.tar.gz"

# Out-of-tree: tarball cached in $TARBALLS, unpacked/built under $WORK.
WORK="${BUILDDIR:?set BUILDDIR -- re-activate the mimuxenv}/$NAME"

download() {
  echo "downloading mandoc source..."
  mkdir -p "$TARBALLS"
  if test -f "$TARBALLS/$TARBALL"; then
    echo "$TARBALL exists, skipping..."
  else
    curl -Lf --retry 5 --retry-delay 5 --retry-all-errors \
      -o "$TARBALLS/$TARBALL" "$BASEURL/$TARBALL"
    # $SRCDIR.sha256 is a vendored checksum manifest shipped in $DIR (not a
    # download artifact); it names the tarball by its bare filename, so we
    # run the check from inside $TARBALLS.
    if ! (cd "$TARBALLS" && sha256sum -c "$DIR/$SRCDIR.sha256"); then
      echo "sha256 failed oops"
      rm -rf "${TARBALLS:?}/$TARBALL"
      exit 1
    fi
  fi
}

extract() {
  echo "extracting mandoc source..."
  if ! test -f "$TARBALLS/$TARBALL"; then
    echo "No tarball to operate on!"
    exit 1
  fi

  rm -rf "$WORK"
  mkdir -p "$WORK"
  tar xzf "$TARBALLS/$TARBALL" -C "$WORK"
  cd "$WORK/$SRCDIR"
  sed -i \
    -e "/^CC=.*$/d"\
    -e "/^AR=.*$/d"\
    -e "/^CFLAGS=.*$/d"\
    -e "/^LDFLAGS=.*$/d"\
    -e "/^PREFIX=.*$/d"\
    -e "/^WWWPREFIX=.*$/d"\
    configure
  PREFIX="/usr"\
  WWPREFIX="/var/www"\
    ./configure --prefix="/usr" --exec-prefix="/usr" --target="$TARGET"\
    --with-sysroot="${ROOTFS:-/}"
}

makeinstall() {
  echo "building mandoc..."
  if ! test -d "$WORK/$SRCDIR"; then
    echo "No source directory to operate on!"
    exit 1
  fi
  cd "$WORK/$SRCDIR"

  make -j"${JOBS:-8}"
  make -j"${JOBS:-8}" DESTDIR="$ROOTFS" install
}

clear() {
  rm -rf "$WORK"
}

case "$1" in
  download|d)
    download
    ;;
  extract|e)
    extract
    ;;
  makeinstall|mi)
    makeinstall
    ;;
  clear|clean|c)
    clear
    ;;
  all|a)
    download && extract && makeinstall
    ;;
  *)
    cat <<EOF
Build script for mandoc

download|d -> download the tarball
extract|e -> extract and patch the tarball
makeinstall|mi -> make and install the build artifacts
clear|clean|c -> clean all artifacts
all|a -> clean, and then go through everything.
EOF
    exit 1
    ;;
esac
