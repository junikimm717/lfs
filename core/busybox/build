#!/bin/sh
set -eu

DIR="$(realpath "$(dirname "$0" )" )"
NAME="$(basename "$DIR")"

# You MUST make sure that we are in a correct environment.
test -z "$INOSENV" && \
  echo "You cannot run this script while not in the mimuxenv!" && \
  exit 1

VERSION="1.36.1"
BASEURL="https://github.com/mirror/busybox/archive/refs/tags"
SRCDIR="busybox-$(echo "$VERSION" | tr '.' '_')"
TARBALL="$SRCDIR.tar.gz"

# Out-of-tree: tarball cached in $TARBALLS, unpacked/built under $WORK. The
# .config and net.patch are vendored inputs kept in $DIR.
WORK="$BUILDDIR/$NAME"

download() {
  mkdir -p "$TARBALLS"
  if test -f "$TARBALLS/$TARBALL"; then
    echo "$TARBALL exists, skipping..."
    return
  fi
  echo "downloading busybox source"
  curl -Lf --retry 5 --retry-delay 5 --retry-all-errors \
    "$BASEURL/$(echo "$VERSION" | tr '.' '_').tar.gz" -o "$TARBALLS/$TARBALL"
}

HOSTCC="$(PATH='/bin:/usr/bin:/usr/local/bin:/usr/sbin:/sbin' command -v gcc)"
export HOSTCC

menuconfig() {
  cd "$WORK/$SRCDIR"
  # STUPID busybox and HOSTCC (same issues as kernel) GAHHHHHHHH
  LD_LIBRARY_PATH=/lib:/usr/lib make menuconfig HOSTCC="$HOSTCC"
}

extract() {
  if ! test -f "$TARBALLS/$TARBALL"; then
    echo "No tarball to operate on!"
    exit 1
  fi
  echo "extracting busybox source and applying config..."
  rm -rf "$WORK"
  mkdir -p "$WORK"
  tar xzf "$TARBALLS/$TARBALL" -C "$WORK"
  cd "$WORK/$SRCDIR"
  patch -p1 < "$DIR/net.patch"
  # actually skull emoji of a patch
  sed -i\
    -e "s|main|int main|g"\
    "$WORK/$SRCDIR/scripts/kconfig/lxdialog/check-lxdialog.sh"
  cp -a "$DIR/config" "$WORK/$SRCDIR/.config"
}

makeinstall() {
  echo "building busybox"
  if ! test -d "$WORK/$SRCDIR"; then
    echo "No source directory to operate on!"
    exit 1
  fi
  cd "$WORK/$SRCDIR"
  make -j"${JOBS:-8}" HOSTCC="$(PATH=/bin:/usr/bin:/usr/local/bin:/usr/sbin:/sbin command -v gcc)"\
    HOSTCXX="$(PATH=/bin:/usr/bin:/usr/local/bin:/usr/sbin:/sbin command -v g++)" \
    CC="$CC" AR="$AR" LD="$LD"
  # install to both dist (main system) and initramfs
  make CONFIG_PREFIX="$ROOTFS" install
}

clear() {
  # Drop the out-of-tree build dir. The cached tarball in $TARBALLS is kept.
  rm -rf "$WORK"
}

case "$1" in
  download|d)
    download
    ;;
  extract|e)
    extract
    ;;
  menu)
    menuconfig
    ;;
  makeinstall|mi)
    makeinstall
    ;;
  clear|clean|c)
    clear
    ;;
  all|a)
    download && extract && makeinstall
    ;;
  *)
    cat <<EOF
Build script for busybox

download|d -> download the tarball into \$TARBALLS
extract|e -> extract and patch the tarball under \$BUILDDIR
menu -> create a menuconfig
makeinstall|mi -> make and install busybox into the rootfs
clear|clean|c -> remove the out-of-tree build dir
all|a -> download, extract, and makeinstall.
EOF
    exit 1
    ;;
esac
