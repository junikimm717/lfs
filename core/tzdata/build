#!/bin/sh

set -e

DIR="$(realpath "$(dirname "$0" )" )"
NAME="$(basename "$DIR")"

# You MUST make sure that we are in a correct environment.
test -z "$INOSENV" && {
  echo "You cannot run this script while not in the mimuxenv!" && \
  exit 1;
}

# tzdata requires explicit updates.

VERSION="2026c"
BASEURL="https://data.iana.org/time-zones/releases"
SRCDIR="tz$VERSION"
TARBALL="tzdata$VERSION.tar.gz"
TARBALL2="tzcode$VERSION.tar.gz"

# Out-of-tree: tarballs cached in $TARBALLS, unpacked/built under $WORK.
WORK="$BUILDDIR/$NAME"

export CFLAGS="$CFLAGS -static"
export LDFLAGS="$LDFLAGS -static"

download() {
  echo "downloading tzdata source..."
  mkdir -p "$TARBALLS"

  if test -f "$TARBALLS/$TARBALL"; then
    echo "$TARBALL exists, skipping..."
  else
    curl -Lf --retry 5 --retry-delay 5 --retry-all-errors \
      -o "$TARBALLS/$TARBALL" "$BASEURL/$TARBALL"
  fi

  if test -f "$TARBALLS/$TARBALL2"; then
    echo "$TARBALL2 exists, skipping..."
  else
    curl -Lf --retry 5 --retry-delay 5 --retry-all-errors \
      -o "$TARBALLS/$TARBALL2" "$BASEURL/$TARBALL2"
  fi

}

extract() {
  echo "extracting tzdata source..."
  if ! test -f "$TARBALLS/$TARBALL"; then
    echo "No tarball to operate on!"
    exit 1
  fi

  rm -rf "$WORK"
  mkdir -p "$WORK/$SRCDIR" && cd "$WORK/$SRCDIR"
  tar xzf "$TARBALLS/$TARBALL"
  tar xzf "$TARBALLS/$TARBALL2"
}

makeinstall() {
  echo "building tzdata..."
  if ! test -d "$WORK/$SRCDIR"; then
    echo "No source directory to operate on!"
    exit 1
  fi
  set -x
  cd "$WORK/$SRCDIR"

  make -j"${JOBS:-8}"
  make -j"${JOBS:-8}" DESTDIR="$ROOTFS" install

  # default timezone should be New York (AKA concretehouse's TZ)
  ln -sfn /usr/share/zoneinfo/America/New_York "$ROOTFS/etc/localtime"
}

clear() {
  rm -rf "$WORK"
}

case "$1" in
  download|d)
    download
    ;;
  extract|e)
    extract
    ;;
  makeinstall|mi)
    makeinstall
    ;;
  clear|clean|c)
    clear
    ;;
  all|a)
    download && extract && makeinstall
    ;;
  *)
    cat <<EOF
Build script for tzdata

download|d -> download the tarballs into \$TARBALLS
extract|e -> extract the tarballs under \$BUILDDIR
makeinstall|mi -> make and install the build artifacts
clear|clean|c -> remove the out-of-tree build dir
all|a -> download, extract, and makeinstall.
EOF
    exit 1
    ;;
esac
