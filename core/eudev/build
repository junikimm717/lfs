#!/bin/sh
set -eu

DIR="$(realpath "$(dirname "$0" )" )"
NAME="$(basename "$DIR")"

# You MUST make sure that we are in a correct environment.
test -z "$INOSENV" && {
  echo "You cannot run this script while not in the mimuxenv!" && \
  exit 1;
}

VERSION="3.2.14"
BASEURL="https://github.com/eudev-project/eudev/releases/download/v$VERSION"
SRCDIR="eudev-$VERSION"
TARBALL="$SRCDIR.tar.gz"

# Out-of-tree: tarball cached in $TARBALLS, unpacked/built under $WORK.
WORK="$BUILDDIR/$NAME"

download() {
  echo "downloading eudev source..."
  mkdir -p "$TARBALLS"
  if test -f "$TARBALLS/$TARBALL"; then
    echo "$TARBALL exists, skipping..."
    return
  fi

  curl -Lf --retry 5 --retry-delay 5 --retry-all-errors \
    -o "$TARBALLS/$TARBALL" "$BASEURL/$TARBALL"
}

extract() {
  echo "extracting eudev source..."
  if ! test -f "$TARBALLS/$TARBALL"; then
    echo "No tarball to operate on!"
    exit 1
  fi

  rm -rf "$WORK"
  mkdir -p "$WORK"
  tar xzf "$TARBALLS/$TARBALL" -C "$WORK"
  cd "$WORK/$SRCDIR"
  # monkey patched for now, but bad idea to hard code /usr/bin
  # ideal scenario, we just never search for g++ because IT's NOT NEEDED
  # kmod stays off (the kernel is CONFIG_MODULES=n). blkid is ON: userspace.sh
  # now builds util-linux before eudev, so libblkid is present in the sysroot
  # and udev's blkid builtin can populate /dev/disk/by-{uuid,label,partuuid}
  # (and stop logging "IMPORT{builtin}: 'blkid' unknown" from the stock rules).
  # Linking stays dynamic like the rest of the rootfs.
  ./configure --prefix="/" --exec-prefix="/" --host="$TARGET"\
    --with-sysroot="${ROOTFS:-/}"\
    --disable-kmod --enable-blkid --disable-selinux --disable-manpages
}


makeinstall() {
  echo "building eudev..."
  if ! test -d "$WORK/$SRCDIR"; then
    echo "No source directory to operate on!"
    exit 1
  fi
  cd "$WORK/$SRCDIR"

  make -j"${JOBS:-8}"
  make -j"${JOBS:-8}" DESTDIR="$ROOTFS" install
}

clear() {
  rm -rf "$WORK"
}

case "$1" in
  download|d)
    download
    ;;
  extract|e)
    extract
    ;;
  makeinstall|mi)
    makeinstall
    ;;
  clear|clean|c)
    clear
    ;;
  all|a)
    download && extract && makeinstall
    ;;
  *)
    cat <<EOF
Build script for eudev

download|d -> download the tarball
extract|e -> extract and patch the tarball
makeinstall|mi -> make and install the build artifacts
clear|clean|c -> clean all artifacts
all|a -> clean, and then go through everything.
EOF
    exit 1
    ;;
esac
