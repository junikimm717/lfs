#!/bin/sh
set -eu

DIR="$(realpath "$(dirname "$0" )" )"
NAME="$(basename "$DIR")"

# You MUST make sure that we are in a correct environment.
test -z "$INOSENV" && {
  echo "You cannot run this script while not in the mimuxenv!" && \
  exit 1;
}

VERSION="14.4.0"
SRCDIR="gcc-$VERSION"
BASEURL="https://ftp.gnu.org/gnu/gcc/$SRCDIR"
TARBALL="$SRCDIR.tar.xz"

OBJDIR="dist"

# Out-of-tree: tarball cached in $TARBALLS, unpacked/built under $WORK.
WORK="$BUILDDIR/$NAME"

download() {
  echo "downloading gcc source..."
  mkdir -p "$TARBALLS"
  if test -f "$TARBALLS/$TARBALL"; then
    echo "$TARBALL exists, skipping..."
    return
  fi

  curl -Lf --retry 5 --retry-delay 5 --retry-all-errors \
    -o "$TARBALLS/$TARBALL" "$BASEURL/$TARBALL"
}

extract() {
  echo "extracting gcc source..."
  if ! test -f "$TARBALLS/$TARBALL"; then
    echo "No tarball to operate on!"
    exit 1
  fi

  rm -rf "$WORK"
  mkdir -p "$WORK"
  tar xf "$TARBALLS/$TARBALL" -C "$WORK"
  cd "$WORK/$SRCDIR"
  case $(uname -m) in
    x86_64)
      sed -e '/m64=/s/lib64/lib/' \
        -i.orig gcc/config/i386/t-linux64
    ;;
    aarch64)
      sed -e 's/lib64/lib/'\
        -i.orig gcc/config/aarch64/t-aarch64-linux
    ;;
  esac
  sed '/thread_header =/s/@.*@/gthr-posix.h/' \
    -i libgcc/Makefile.in libstdc++-v3/include/Makefile.in

  # gcc bundles the same libiberty as binutils, whose getopt1.c calls
  # _getopt_internal() with no in-scope prototype under musl (musl's
  # <getopt.h> predefines the _GETOPT_H guard, so libiberty's declaration is
  # skipped). GCC 14+ treats implicit function declarations as a hard error,
  # which breaks both the build-libiberty and host libiberty stages. The symbol
  # is defined by libiberty's own getopt.c and links fine, so downgrade the
  # diagnostic. Exporting it into CFLAGS (rather than only CC) ensures it also
  # reaches CC_FOR_BUILD/CFLAGS_FOR_BUILD used for the build-side libiberty.
  export CFLAGS="${CFLAGS:-} -Wno-error=implicit-function-declaration"

  mkdir -p "$WORK/$OBJDIR" && cd "$WORK/$OBJDIR"

  # This gcc will be used when we are actually booted into our system.
  # Therefore, its sysroot must be set to /
  "$WORK/$SRCDIR/configure" \
    --prefix="/usr" \
    --target="$TARGET" \
    --libdir=/usr/lib \
    --disable-fixed-point \
    --disable-libquadmath \
    --disable-decimal-float \
    --enable-default-pie \
    --enable-default-ssp \
    --program-prefix= \
    LDFLAGS_FOR_TARGET="-L$PWD/$TARGET/libgcc"\
    --disable-nls \
    --with-sysroot=/ \
    --with-build-sysroot="${ROOTFS:-/}" \
    --enable-libatomic \
    --enable-languages=c,c++ \
    --disable-bootstrap \
    --disable-assembly \
    --disable-werror \
    --disable-multilib \
    --disable-lto \
    --enable-tls \
    --disable-libmudflap \
    --disable-libsanitizer \
    --disable-gnu-indirect-function \
    --disable-libmpx \
    --enable-shared \
    --enable-initfini-array \
    --enable-libstdcxx-time=rt \
    CC="$CC $CFLAGS -fPIC"\
    CXX="$CXX $CXXFLAGS -fPIC"\

}

makeinstall() {
  echo "building gcc..."
  if ! test -d "$WORK/$OBJDIR" -a -d "$WORK/$SRCDIR"; then
    echo "No source directory to operate on!"
    exit 1
  fi
  cd "$WORK/$OBJDIR"

  make -j"${JOBS:-8}" all-gcc
  make -j"${JOBS:-8}" all-target-libgcc
  make -j"${JOBS:-8}" all-target-libstdc++-v3 CXXFLAGS="-fPIC"
  make -j"${JOBS:-8}" all-target-libatomic CXXFLAGS="-fPIC"

  make -j"${JOBS:-8}" DESTDIR="$ROOTFS" install-gcc
  make -j"${JOBS:-8}" DESTDIR="$ROOTFS" install-target-libgcc
  make -j"${JOBS:-8}" DESTDIR="$ROOTFS" install-target-libstdc++-v3
  make -j"${JOBS:-8}" DESTDIR="$ROOTFS" install-target-libatomic
  ln -sfn gcc "$ROOTFS/usr/bin/cc"
}

clear() {
  rm -rf "$WORK"
}

case "$1" in
  download|d)
    download
    ;;
  extract|e)
    extract
    ;;
  makeinstall|mi)
    makeinstall
    ;;
  clear|clean|c)
    clear
    ;;
  all|a)
    download && extract && makeinstall
    ;;
  *)
    cat <<EOF
Build script for gcc

download|d -> download the tarball
extract|e -> extract and patch the tarball
makeinstall|mi -> make and install the build artifacts
clear|clean|c -> clean all artifacts
all|a -> clean, and then go through everything.
EOF
    exit 1
    ;;
esac
