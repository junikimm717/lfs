#!/bin/sh
set -eu

DIR="$(realpath "$(dirname "$0" )" )"
cd "$DIR"

# You MUST make sure that we are in a correct environment.
test -z "$INOSENV" && {
  echo "You cannot run this script while not in the mimuxenv!" && \
  exit 1;
}

VERSION=""
BASEURL="https://curl.se/ca"
TARBALL="cacert.pem"

# certs ships a single PEM (no archive to unpack). It is cached in $TARBALLS
# like every other download; update-cacert is a vendored input in $DIR.

download() {
  echo "downloading certs source..."
  mkdir -p "$TARBALLS"
  if test -f "$TARBALLS/$TARBALL"; then
    echo "$TARBALL exists, skipping..."
    return
  fi
  curl -Lf --retry 5 --retry-delay 5 --retry-all-errors \
    -o "$TARBALLS/$TARBALL" "$BASEURL/$TARBALL"
}

extract() {
  echo "checking certs source..."
  if ! test -f "$TARBALLS/$TARBALL"; then
    echo "No cert to operate on!"
    exit 1
  fi
}

makeinstall() {
  echo "building certs..."
  if ! test -f "$TARBALLS/$TARBALL"; then
    echo "No cert to operate on!"
    exit 1
  fi
  install -m755 "$TARBALLS/$TARBALL" "$ROOTFS/etc/ssl/cert.pem"
  install -m755 "$DIR/update-cacert" "$ROOTFS/usr/bin/"
  ln -sfn /etc/ssl/cert.pem "$ROOTFS/etc/ssl/certs/ca-certificates.crt"
}

clear() {
  # Only a cached PEM in $TARBALLS; nothing package-local to remove.
  true
}

cd "$DIR"
case "$1" in
  download|d)
    download
    ;;
  extract|e)
    extract
    ;;
  makeinstall|mi)
    makeinstall
    ;;
  clear|clean|c)
    clear
    ;;
  all|a)
    download && extract && makeinstall
    ;;
  *)
    cat <<EOF
Build script for certs

download|d -> download the tarball
extract|e -> extract and patch the tarball
makeinstall|mi -> make and install the build artifacts
clear|clean|c -> clean all artifacts
all|a -> clean, and then go through everything.
EOF
    exit 1
    ;;
esac
