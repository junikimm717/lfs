#!/bin/sh
set -eu

DIR="$(realpath "$(dirname "$0" )" )"
NAME="$(basename "$DIR")"

# You MUST make sure that we are in a correct environment.
test -z "$INOSENV" && {
  echo "You cannot run this script while not in the mimuxenv!" && \
  exit 1;
}

VERSION="2026.94"
BASEURL="https://codeload.github.com/mkj/dropbear/tar.gz/refs/tags"
SRCDIR="dropbear-DROPBEAR_$VERSION"
TARBALL="DROPBEAR_$VERSION.tar.gz"

# Out-of-tree: tarball cached in $TARBALLS, unpacked/built under $WORK.
WORK="${BUILDDIR:?set BUILDDIR -- re-activate the mimuxenv}/$NAME"

download() {
  echo "downloading dropbear source..."
  mkdir -p "$TARBALLS"
  if test -f "$TARBALLS/$TARBALL"; then
    echo "$TARBALL exists, skipping..."
    return
  fi

  curl -Lf --retry 5 --retry-delay 5 --retry-all-errors \
    -o "$TARBALLS/$TARBALL" "$BASEURL/DROPBEAR_$VERSION"
}

extract() {
  echo "extracting dropbear source..."
  if ! test -f "$TARBALLS/$TARBALL"; then
    echo "No tarball to operate on!"
    exit 1
  fi

  rm -rf "$WORK"
  mkdir -p "$WORK"
  tar xzf "$TARBALLS/$TARBALL" -C "$WORK"
  mv "$WORK/$SRCDIR" "$WORK/dropbear"
  cd "$WORK/dropbear"
  ./configure --prefix="/usr" \
    --host="$TARGET" \
    --with-sysroot="${ROOTFS:-/}" \
    --disable-harden
}

makeinstall() {
  echo "building dropbear..."
  if ! test -d "$WORK/dropbear"; then
    echo "No source directory to operate on!"
    exit 1
  fi
  cd "$WORK/dropbear"

  make -j"${JOBS:-8}" PROGRAMS="dropbear dropbearkey dbclient scp"
  make PROGRAMS="dropbear dropbearkey dbclient scp" DESTDIR="$ROOTFS" install
}

clear() {
  rm -rf "$WORK"
}

case "$1" in
  download|d)
    download
    ;;
  extract|e)
    extract
    ;;
  makeinstall|mi)
    makeinstall
    ;;
  clear|clean|c)
    clear
    ;;
  all|a)
    download && extract && makeinstall
    ;;
  *)
    cat <<EOF
Build script for dropbear (ssh server + client)

download|d -> download the tarball into \$TARBALLS
extract|e -> extract the tarball under \$BUILDDIR
makeinstall|mi -> make and install the tarball into \$ROOTFS
clear|clean|c -> remove the out-of-tree build dir
all|a -> download, extract, and makeinstall.
EOF
    exit 1
    ;;
esac
