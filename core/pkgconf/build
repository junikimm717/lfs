#!/bin/sh

set -eu

DIR="$(realpath "$(dirname "$0" )" )"
NAME="$(basename "$DIR")"

# You MUST make sure that we are in a correct environment.
test -z "$INOSENV" && {
  echo "You cannot run this script while not in the mimuxenv!" && \
  exit 1;
}

VERSION="3.0.5"
# The GitHub tag tarballs ship no pregenerated ./configure; the upstream
# release tarballs on distfiles do, which keeps autotools out of the build.
BASEURL="https://distfiles.ariadne.space/pkgconf"
SRCDIR="pkgconf-$VERSION"
TARBALL="$SRCDIR.tar.xz"

# Out-of-tree: tarball cached in $TARBALLS, unpacked/built under $WORK.
WORK="${BUILDDIR:?set BUILDDIR -- re-activate the mimuxenv}/$NAME"

download() {
  echo "downloading pkgconf source..."
  mkdir -p "$TARBALLS"
  if test -f "$TARBALLS/$TARBALL"; then
    echo "$TARBALL exists, skipping..."
  else
    curl -Lf --retry 5 --retry-delay 5 --retry-all-errors \
      -o "$TARBALLS/$TARBALL" "$BASEURL/$TARBALL"
  fi
}

extract() {
  echo "extracting pkgconf source..."
  if ! test -f "$TARBALLS/$TARBALL"; then
    echo "No tarball to operate on!"
    exit 1
  fi

  rm -rf "$WORK"
  mkdir -p "$WORK"
  tar xf "$TARBALLS/$TARBALL" -C "$WORK"
  cd "$WORK/$SRCDIR"
  # The default search path is ${libdir}/pkgconfig:${datadir}/pkgconfig.
  # /lib/pkgconfig is appended because core packages installed with prefix=/
  # (eudev) drop their .pc files there.
  ./configure --prefix="/usr" --exec-prefix="/usr" --target="$TARGET"\
    --with-sysroot="${ROOTFS:-/}"\
    --with-pkg-config-dir="/usr/lib/pkgconfig:/usr/share/pkgconfig:/lib/pkgconfig"\
    --with-system-libdir="/usr/lib:/lib"\
    --with-system-includedir="/usr/include"
}

makeinstall() {
  echo "building pkgconf..."
  if ! test -d "$WORK/$SRCDIR"; then
    echo "No source directory to operate on!"
    exit 1
  fi
  cd "$WORK/$SRCDIR"

  make -j"${JOBS:-8}"
  make -j"${JOBS:-8}" DESTDIR="$ROOTFS" install

  # `make install` ships only the pkgconf name; every configure script and
  # meson build in existence looks for pkg-config.
  ln -sfn pkgconf "$ROOTFS/usr/bin/pkg-config"

  # SBOM/.pc-linting tools that come along with pkgconf; nothing in mimux uses them.
  for tool in bomtool spdxtool pccritic; do
    rm -f "$ROOTFS/usr/bin/$tool" "$ROOTFS/usr/share/man/man1/$tool.1"
  done
}

clear() {
  # Drop the out-of-tree build dir. The cached tarball in $TARBALLS is kept.
  rm -rf "$WORK"
}

case "$1" in
  download|d)
    download
    ;;
  extract|e)
    extract
    ;;
  makeinstall|mi)
    makeinstall
    ;;
  clear|clean|c)
    clear
    ;;
  all|a)
    download && extract && makeinstall
    ;;
  *)
    cat <<EOF
Build script for pkgconf

download|d -> download the tarball into \$TARBALLS
extract|e -> extract the tarball under \$BUILDDIR
makeinstall|mi -> make and install the build artifacts
clear|clean|c -> remove the out-of-tree build dir
all|a -> download, extract, and makeinstall.
EOF
    exit 1
    ;;
esac
