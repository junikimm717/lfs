#!/bin/sh
set -eu

DIR="$(realpath "$(dirname "$0" )" )"
NAME="$(basename "$DIR")"

# You MUST make sure that we are in a correct environment.
test -z "$INOSENV" && {
  echo "You cannot run this script while not in the mimuxenv!" && \
  exit 1;
}

VERSION="3.14.6"
BASEURL="https://www.python.org/ftp/python/$VERSION"
SRCDIR="Python-$VERSION"
TARBALL="$SRCDIR.tar.xz"

# Out-of-tree: tarball cached in $TARBALLS, unpacked/built under $WORK. Setup is
# a vendored input kept in $DIR.
WORK="${BUILDDIR:?set BUILDDIR -- re-activate the mimuxenv}/$NAME"

# python actually just shits itself without this.
export LD_LIBRARY_PATH="$ROOTFS/lib:$ROOTFS/usr/lib"

download() {
  echo "downloading python3 source..."
  mkdir -p "$TARBALLS"
  if test -f "$TARBALLS/$TARBALL"; then
    echo "$TARBALL exists, skipping..."
    return
  fi
  curl -Lf --retry 5 --retry-delay 5 --retry-all-errors \
    -o "$TARBALLS/$TARBALL" "$BASEURL/$TARBALL"
}

extract() {
  echo "extracting python3 source..."
  if ! test -f "$TARBALLS/$TARBALL"; then
    echo "No tarball to operate on!"
    exit 1
  fi

  rm -rf "$WORK"
  mkdir -p "$WORK"
  tar xf "$TARBALLS/$TARBALL" -C "$WORK"
  cd "$WORK/$SRCDIR"
  cp -a "$DIR/Setup" ./Modules/Setup.local
  ./configure --prefix="/usr" --exec-prefix="/usr"\
    --with-sysroot="${ROOTFS:-/}"\
    --with-openssl="/usr"\
    --enable-shared \
    --disable-static \
    --without-static-libpython \
    --disable-test-modules \
    CFLAGS="$CFLAGS -fPIC"\
    LDFLAGS="$LDFLAGS"
}


makeinstall() {
  echo "building python3..."
  if ! test -d "$WORK/$SRCDIR"; then
    echo "No source directory to operate on!"
    exit 1
  fi
  cd "$WORK/$SRCDIR"
  # In 3.14 the HACL* rewrite means _sha2 and _blake2 link against the prebuilt
  # static archives (Modules/_hacl/libHacl_Hash_{SHA2,BLAKE2}.a) we reference in
  # Setup.local. The makesetup-generated link rules name those archives on the
  # link line but do NOT list them as prerequisites (the module LDEPS point at
  # the shared .o object list instead), so make never builds them and the link
  # dies with "cannot find .../libHacl_Hash_SHA2.a". Build the archives first.
  make -j"${JOBS:-8}" Modules/_hacl/libHacl_Hash_SHA2.a Modules/_hacl/libHacl_Hash_BLAKE2.a
  make -j"${JOBS:-8}"
  make -j"${JOBS:-8}" DESTDIR="$ROOTFS" install

  MAJORMINOR="$(echo "$VERSION" | cut -d '.' -f 1-2)"
  ln -sfn "python$MAJORMINOR" "$ROOTFS/usr/bin/python3"
  ln -sfn "pip3" "$ROOTFS/usr/bin/pip"
  # reduce bloat.
  rm -rf "$ROOTFS/usr/lib/python$MAJORMINOR/test"
}

clear() {
  # Drop the out-of-tree build dir. The cached tarball in $TARBALLS is kept.
  rm -rf "$WORK"
}

case "$1" in
  download|d)
    download
    ;;
  extract|e)
    extract
    ;;
  makeinstall|mi)
    makeinstall
    ;;
  clear|clean|c)
    clear
    ;;
  all|a)
    download && extract && makeinstall
    ;;
  *)
    cat <<EOF
Build script for python3

download|d -> download the tarball into \$TARBALLS
extract|e -> extract and patch the tarball under \$BUILDDIR
makeinstall|mi -> make and install the build artifacts
clear|clean|c -> remove the out-of-tree build dir
all|a -> download, extract, and makeinstall.
EOF
    exit 1
    ;;
esac
